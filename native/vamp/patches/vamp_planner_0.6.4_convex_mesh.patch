diff --git a/src/impl/vamp/collision/sphere_convex_mesh.hh b/src/impl/vamp/collision/sphere_convex_mesh.hh
new file mode 100644
index 0000000..617ed7b
--- /dev/null
+++ b/src/impl/vamp/collision/sphere_convex_mesh.hh
@@ -0,0 +1,144 @@
+#pragma once
+
+#include <vamp/collision/shapes.hh>
+#include <vamp/collision/sphere_cuboid.hh>
+#include <vamp/collision/math.hh>
+
+namespace vamp::collision
+{
+    template <typename DataT>
+    inline constexpr auto minimum(const DataT &a, const DataT &b) noexcept -> DataT
+    {
+        return a.blend(b, b < a);
+    }
+
+    template <typename DataT>
+    inline constexpr auto point_segment_sql2(
+        const DataT &px,
+        const DataT &py,
+        const DataT &pz,
+        const DataT &ax,
+        const DataT &ay,
+        const DataT &az,
+        const DataT &bx,
+        const DataT &by,
+        const DataT &bz) noexcept -> DataT
+    {
+        const auto vx = bx - ax;
+        const auto vy = by - ay;
+        const auto vz = bz - az;
+        const auto wx = px - ax;
+        const auto wy = py - ay;
+        const auto wz = pz - az;
+        const auto denominator = dot_3(vx, vy, vz, vx, vy, vz);
+        const auto fraction = (dot_3(wx, wy, wz, vx, vy, vz) / denominator).clamp(0.F, 1.F);
+        return sql2_3(px, py, pz, ax + fraction * vx, ay + fraction * vy, az + fraction * vz);
+    }
+
+    template <typename DataT>
+    inline constexpr auto point_triangle_sql2(
+        const Triangle<DataT> &triangle,
+        const DataT &px,
+        const DataT &py,
+        const DataT &pz) noexcept -> DataT
+    {
+        const auto abx = triangle.bx - triangle.ax;
+        const auto aby = triangle.by - triangle.ay;
+        const auto abz = triangle.bz - triangle.az;
+        const auto acx = triangle.cx - triangle.ax;
+        const auto acy = triangle.cy - triangle.ay;
+        const auto acz = triangle.cz - triangle.az;
+        const auto apx = px - triangle.ax;
+        const auto apy = py - triangle.ay;
+        const auto apz = pz - triangle.az;
+        const auto d00 = dot_3(abx, aby, abz, abx, aby, abz);
+        const auto d01 = dot_3(abx, aby, abz, acx, acy, acz);
+        const auto d11 = dot_3(acx, acy, acz, acx, acy, acz);
+        const auto d20 = dot_3(apx, apy, apz, abx, aby, abz);
+        const auto d21 = dot_3(apx, apy, apz, acx, acy, acz);
+        const auto denominator = d00 * d11 - d01 * d01;
+        const auto barycentric_b = (d11 * d20 - d01 * d21) / denominator;
+        const auto barycentric_c = (d00 * d21 - d01 * d20) / denominator;
+        const auto barycentric_a = 1.F - barycentric_b - barycentric_c;
+        const auto projection_inside =
+            (barycentric_a >= 0.F) & (barycentric_b >= 0.F) & (barycentric_c >= 0.F);
+        const auto signed_plane_distance =
+            dot_3(apx, apy, apz, triangle.nx, triangle.ny, triangle.nz);
+        const auto plane_sql2 = signed_plane_distance * signed_plane_distance;
+        const auto ab_sql2 = point_segment_sql2(
+            px,
+            py,
+            pz,
+            triangle.ax,
+            triangle.ay,
+            triangle.az,
+            triangle.bx,
+            triangle.by,
+            triangle.bz);
+        const auto bc_sql2 = point_segment_sql2(
+            px,
+            py,
+            pz,
+            triangle.bx,
+            triangle.by,
+            triangle.bz,
+            triangle.cx,
+            triangle.cy,
+            triangle.cz);
+        const auto ca_sql2 = point_segment_sql2(
+            px,
+            py,
+            pz,
+            triangle.cx,
+            triangle.cy,
+            triangle.cz,
+            triangle.ax,
+            triangle.ay,
+            triangle.az);
+        const auto edge_sql2 = minimum(minimum(ab_sql2, bc_sql2), ca_sql2);
+        return edge_sql2.blend(plane_sql2, projection_inside);
+    }
+
+    template <typename DataT>
+    inline constexpr auto sphere_convex_mesh(
+        const ConvexMesh<DataT> &mesh,
+        const DataT &x,
+        const DataT &y,
+        const DataT &z,
+        const DataT &radius) noexcept -> DataT
+    {
+        const auto broad_phase = sphere_cuboid(mesh.bounds, x, y, z, radius * radius);
+        if (broad_phase.test_zero())
+        {
+            return broad_phase;
+        }
+
+        const auto &first = mesh.triangles.front();
+        auto surface_sql2 = point_triangle_sql2(first, x, y, z);
+        auto maximum_plane_distance = dot_3(
+            x - first.ax,
+            y - first.ay,
+            z - first.az,
+            first.nx,
+            first.ny,
+            first.nz);
+        for (auto index = 1U; index < mesh.triangles.size(); ++index)
+        {
+            const auto &triangle = mesh.triangles[index];
+            surface_sql2 = minimum(
+                surface_sql2,
+                point_triangle_sql2(triangle, x, y, z));
+            maximum_plane_distance = maximum_plane_distance.max(dot_3(
+                x - triangle.ax,
+                y - triangle.ay,
+                z - triangle.az,
+                triangle.nx,
+                triangle.ny,
+                triangle.nz));
+        }
+        const auto expanded_radius = radius + mesh.margin;
+        const auto radius_sql2 = expanded_radius * expanded_radius;
+        const auto outside_result = surface_sql2 - radius_sql2;
+        return outside_result.blend(-radius_sql2, maximum_plane_distance <= 0.F);
+    }
+}  // namespace vamp::collision
