<mujoco model="gen3_with_tank">
  <compiler angle="degree"/>

  <option integrator="implicitfast"/>

  <!-- target_*_visual and target_*_collision_* form the shared object asset
       boundary for every task that loads this MJCF. Collision geoms are
       massless so adding convex parts does not change body inertia. -->
  <default>
    <default class="target_object_visual">
      <geom contype="0" conaffinity="0" group="0"/>
    </default>
    <default class="target_object_collision">
      <geom type="mesh" contype="1" conaffinity="1" condim="6"
        friction="1 0.1 0.01" density="0" group="3" rgba="0 0 0 0"/>
      <default class="target_hex_key_collision">
        <geom pos="-0.059531249 0.014319250 0" euler="90 0 0"/>
      </default>
      <default class="target_drill_bit_collision">
        <geom pos="-0.004000000 -0.040000000 -0.000037047"/>
      </default>
      <default class="target_glove_collision">
        <geom pos="-0.048384124 0.067654407 0" euler="90 0 0"/>
      </default>
      <default class="target_notebook_collision">
        <geom pos="-0.167974830 0.084773737 -0.002248173" euler="0 90 180"/>
      </default>
      <default class="target_marker_collision">
        <geom pos="0.018773122 0 0.009581937" euler="0 90 0"/>
      </default>
      <default class="target_rivet_gun_collision">
        <geom pos="0.032206425 0.019703770 0.013947060" euler="0 90 0"/>
      </default>
      <default class="target_standard_part_collision">
        <geom pos="0 0.007100000 0.002694798" euler="90 0 0"/>
      </default>
      <default class="target_tape_collision">
        <geom pos="0.038000001 0.038000001 0.020000000" euler="180 0 90"/>
      </default>
    </default>
  </default>

  <asset>
    <model name="gen3" file="kinova_gen3/gen3.xml"/>
    <model name="tank_model" file="tank/tank.xml"/>

    <include file="things/target_object_assets.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <statistic center="0.25 0.45 0.45" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="gen3_mount" pos="0.43 0.95 0.5" euler="0 0 -90">
      <attach model="gen3" prefix="gen3_"/>
    </body>

    <body name="tank" pos="0 0 0" euler="0 0 0">
      <attach model="tank_model" prefix="tank_"/>
    </body>

    <include file="things/target_objects.xml"/>
  </worldbody>
</mujoco>
