<mujoco model="task2_execution">
  <compiler angle="degree"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="target_object_visual">
      <geom contype="0" conaffinity="0" density="0" group="0"/>
    </default>
    <default class="target_object_collision">
      <geom type="mesh" contype="1" conaffinity="1" condim="6"
        friction="0.45 0.004 0.0001" solref="0.006 1"
        solimp="0.95 0.99 0.001 0.5 2" priority="1" density="0" group="3"
        rgba="0 0 0 0"/>
      <default class="target_marker_collision">
        <geom pos="0.018773122 0 0.009581937" euler="0 90 0"
          friction="0.45 0.004 0.0001" solref="0.006 1"
          solimp="0.95 0.99 0.001 0.5 2"/>
      </default>
      <default class="target_drill_bit_collision">
        <geom pos="-0.004000000 -0.040000000 -0.000037047"
          friction="0.35 0.003 0.0001" solref="0.004 1"
          solimp="0.95 0.99 0.001 0.5 2"/>
      </default>
      <default class="target_rivet_gun_collision">
        <geom pos="0.032206425 0.019703770 0.013947060" euler="0 90 0"
          friction="0.35 0.003 0.0001" solref="0.004 1"
          solimp="0.95 0.99 0.001 0.5 2"/>
      </default>
      <default class="target_standard_part_collision">
        <geom pos="0 0.007100000 0.002694798" euler="90 0 0"
          friction="0.35 0.003 0.0001" solref="0.004 1"
          solimp="0.95 0.99 0.001 0.5 2"/>
      </default>
      <default class="target_tape_collision">
        <geom pos="0.038000001 0.038000001 0.020000000" euler="180 0 90"
          friction="0.55 0.006 0.0002" solref="0.008 1"
          solimp="0.93 0.98 0.002 0.5 2"/>
      </default>
    </default>
  </default>

  <asset>
    <model name="task2_robot" file="kinova_gen3/gen3_with_active_wrist_parallel.xml"/>
    <model name="tank_model" file="tank/tank.xml"/>
    <include file="things/task2_core_object_assets.xml"/>
  </asset>

  <worldbody>
    <body name="robot_mount" pos="0.43 0.95 0.5" euler="0 0 -90">
      <attach model="task2_robot" prefix="robot_"/>
    </body>
    <body name="tank" pos="0 0 0" euler="0 0 0">
      <attach model="tank_model" prefix="tank_"/>
    </body>
    <include file="things/task2_core_objects.xml"/>
  </worldbody>
</mujoco>
