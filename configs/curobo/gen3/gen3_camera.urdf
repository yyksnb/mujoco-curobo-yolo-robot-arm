<?xml version="1.0"?>
<!--
  Kinova Gen3 kinematic chain with a wrist-camera tool frame for cuRobo planning.
  Joint origins and limits mirror examples/mujoco/kinova_gen3/gen3.xml, which
  is derived from Kinova's public Gen3 description through MuJoCo Menagerie.
-->
<robot name="kinova_gen3_camera">
  <link name="base_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/base_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/base_link.stl"/></geometry></collision>
  </link>

  <link name="shoulder_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/shoulder_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/shoulder_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_1" type="continuous">
    <origin xyz="0 0 0.15643" rpy="3.141592653589793 0 0"/>
    <parent link="base_link"/><child link="shoulder_link"/>
    <axis xyz="0 0 1"/><limit effort="39" velocity="1.3963"/>
  </joint>

  <link name="half_arm_1_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/half_arm_1_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/half_arm_1_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.005375 -0.12838" rpy="1.5707963267948966 0 0"/>
    <parent link="shoulder_link"/><child link="half_arm_1_link"/>
    <axis xyz="0 0 1"/><limit lower="-2.2497294058206907" upper="2.2497294058206907" effort="39" velocity="1.3963"/>
  </joint>

  <link name="half_arm_2_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/half_arm_2_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/half_arm_2_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_3" type="continuous">
    <origin xyz="0 -0.21038 -0.006375" rpy="-1.5707963267948966 0 0"/>
    <parent link="half_arm_1_link"/><child link="half_arm_2_link"/>
    <axis xyz="0 0 1"/><limit effort="39" velocity="1.3963"/>
  </joint>

  <link name="forearm_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/forearm_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/forearm_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_4" type="revolute">
    <origin xyz="0 0.006375 -0.21038" rpy="1.5707963267948966 0 0"/>
    <parent link="half_arm_2_link"/><child link="forearm_link"/>
    <axis xyz="0 0 1"/><limit lower="-2.5795966344476193" upper="2.5795966344476193" effort="39" velocity="1.3963"/>
  </joint>

  <link name="spherical_wrist_1_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/spherical_wrist_1_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/spherical_wrist_1_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_5" type="continuous">
    <origin xyz="0 -0.20843 -0.006375" rpy="-1.5707963267948966 0 0"/>
    <parent link="forearm_link"/><child link="spherical_wrist_1_link"/>
    <axis xyz="0 0 1"/><limit effort="9" velocity="1.2218"/>
  </joint>

  <link name="spherical_wrist_2_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/spherical_wrist_2_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/spherical_wrist_2_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_6" type="revolute">
    <origin xyz="0 0.00017505 -0.10593" rpy="1.5707963267948966 0 0"/>
    <parent link="spherical_wrist_1_link"/><child link="spherical_wrist_2_link"/>
    <axis xyz="0 0 1"/><limit lower="-2.0996310901491784" upper="2.0996310901491784" effort="9" velocity="1.2218"/>
  </joint>

  <link name="bracelet_link">
    <visual><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/bracelet_with_vision_link.stl"/></geometry></visual>
    <collision><geometry><mesh filename="examples/mujoco/kinova_gen3/assets/bracelet_with_vision_link.stl"/></geometry></collision>
  </link>
  <joint name="joint_7" type="continuous">
    <origin xyz="0 -0.10593 -0.00017505" rpy="-1.5707963267948966 0 0"/>
    <parent link="spherical_wrist_2_link"/><child link="bracelet_link"/>
    <axis xyz="0 0 1"/><limit effort="9" velocity="1.2218"/>
  </joint>

  <link name="wrist_camera"/>
  <joint name="wrist_camera_joint" type="fixed">
    <origin xyz="0 -0.05639 -0.058475" rpy="0 0 3.141592653589793"/>
    <parent link="bracelet_link"/><child link="wrist_camera"/>
  </joint>
</robot>
